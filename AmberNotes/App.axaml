<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:AmberNotes"
             xmlns:vm="using:AmberNotes.ViewModels"
             xmlns:views="using:AmberNotes.Views"
             x:Class="AmberNotes.App"
             RequestedThemeVariant="Dark">

    <!--
        DataTemplates — ViewModel → View mappings.

        Explicit templates for the two navigation pages handle the
        in-window List ↔ Editor switch inside MainView.

        ViewLocator (fallback) resolves the remaining VM types
        (LoginViewModel, MainViewModel, AppViewModel) via naming convention.
    -->
    <Application.DataTemplates>

        <!-- MainListViewModel  →  MainListView  (notes list page) -->
        <DataTemplate DataType="{x:Type vm:MainListViewModel}">
            <views:MainListView />
        </DataTemplate>

        <!-- NoteEditViewModel  →  NoteEditView  (markdown editor page) -->
        <DataTemplate DataType="{x:Type vm:NoteEditViewModel}">
            <views:NoteEditView />
        </DataTemplate>

        <!-- Fallback: resolves LoginViewModel, MainViewModel, AppViewModel etc. -->
        <local:ViewLocator />

    </Application.DataTemplates>

    <!--
        Theme resources are loaded here as the initial default (AmberNoir).
        ThemeService.Initialize() called in App.axaml.cs replaces this entry
        at runtime when the user switches themes — all DynamicResource bindings
        update instantly without any view reload.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://AmberNotes/Styles/Themes/AmberNoir.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!--
            Markdown.Avalonia 12.0.0-a3: MarkdownScrollViewer auto-registers its styles
            when the MarkdownScrollViewer control is first instantiated — no explicit
            MarkdownStyle entry needed in Application.Styles for this alpha release.
        -->
    </Application.Styles>

</Application>
