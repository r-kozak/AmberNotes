<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AmberNotes.ViewModels"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="580"
             x:Class="AmberNotes.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackground}">

  <!--
    ═══════════════════════════════════════════════════════════════════════
    MainView — Dashboard Shell (v0.4 / Step 19)

    Single-window navigation: this view is the shell that hosts
    a top toolbar (mode + theme) and a TransitioningContentControl
    that switches between:
      • MainListView   (MainListViewModel  — notes list)
      • NoteEditView   (NoteEditViewModel  — markdown editor)

    No code-behind navigation logic — 100% MVVM via CurrentPage binding.
    All colours via DynamicResource → instant theme switching.
    ═══════════════════════════════════════════════════════════════════════
  -->

  <Grid RowDefinitions="Auto,*">

    <!-- ═══════════ TOOLBAR (Mode + Theme) ════════════════════════════════ -->
    <Border Grid.Row="0"
            Background="{DynamicResource AppToolbar}"
            Padding="12,8"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource AppBorder}">

      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">

        <!-- ── Center: Mode switcher (segmented control) ──────────────── -->
        <Border Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource AppSurfaceVariant}"
                CornerRadius="10"
                Padding="3">

          <StackPanel Orientation="Horizontal" Spacing="2">

            <!-- PUBLIC button -->
            <Panel>
              <!-- Active state: non-interactive highlighted pill -->
              <Border CornerRadius="7"
                      Padding="12,6"
                      Background="{DynamicResource AppBackground}"
                      IsVisible="{Binding IsPublicMode}">
                <TextBlock Text="🌐 Публічний"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppSecondary}"
                           HorizontalAlignment="Center" />
              </Border>
              <!-- Inactive state: clickable to switch -->
              <Button Content="🌐 Публічний"
                      Command="{Binding SetPublicModeCommand}"
                      Padding="12,6"
                      CornerRadius="7"
                      FontSize="12"
                      IsVisible="{Binding IsPrivateMode}">
                <Button.Styles>
                  <Style Selector="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource AppSubtext}" />
                    <Setter Property="BorderThickness" Value="0" />
                  </Style>
                  <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource AppSurface}" />
                  </Style>
                </Button.Styles>
              </Button>
            </Panel>

            <!-- PRIVATE button -->
            <Panel>
              <!-- Active state: amber/primary highlight pill -->
              <Border CornerRadius="7"
                      Padding="12,6"
                      Background="{DynamicResource AppPrimary}"
                      IsVisible="{Binding IsPrivateMode}">
                <TextBlock Text="🔒 Приватний"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppOnPrimary}"
                           HorizontalAlignment="Center" />
              </Border>
              <!-- Inactive state: clickable to switch -->
              <Button Content="🔒 Приватний"
                      Command="{Binding SetPrivateModeCommand}"
                      Padding="12,6"
                      CornerRadius="7"
                      FontSize="12"
                      IsVisible="{Binding IsPublicMode}">
                <Button.Styles>
                  <Style Selector="Button">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource AppSubtext}" />
                    <Setter Property="BorderThickness" Value="0" />
                  </Style>
                  <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource AppSurface}" />
                  </Style>
                </Button.Styles>
              </Button>
            </Panel>

          </StackPanel>
        </Border>

        <!-- ── Right: Settings + Theme toggle ────────────────────────── -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">

          <!-- Settings -->
          <Button Content="⚙"
                  Command="{Binding GoToSettingsCommand}"
                  ToolTip.Tip="Налаштування"
                  Padding="10,7"
                  CornerRadius="8"
                  FontSize="16" />

          <!-- Theme toggle -->
          <Button Content="{Binding ThemeToggleIcon}"
                  Command="{Binding ToggleThemeCommand}"
                  ToolTip.Tip="{Binding ThemeToggleTip}"
                  Padding="10,7"
                  CornerRadius="8"
                  FontSize="16" />

        </StackPanel>

      </Grid>
    </Border>

    <!-- ═══════════ PAGE CONTENT (List ↔ Editor) ══════════════════════════ -->
    <!--
      TransitioningContentControl drives all in-window navigation.
      CurrentPage is set by MainViewModel:
        • MainListViewModel  → MainListView  (displayed by DataTemplate)
        • NoteEditViewModel  → NoteEditView  (displayed by DataTemplate)
      CrossFade 250 ms gives a smooth, non-jarring page switch.
    -->
    <TransitioningContentControl Grid.Row="1"
                                  Content="{Binding CurrentPage}">
      <TransitioningContentControl.PageTransition>
        <CrossFade Duration="0:0:0.25" />
      </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>

    <!-- ═══════════ PRIVATE MODE GLOW OVERLAY ═══════════════════════════ -->
    <!--
      Rendered above all content (ZIndex=500) but IsHitTestVisible=False
      so it never blocks clicks/taps.
      Creates a warm amber border-glow around the entire view when in
      Private mode — a subtle visual cue that data is protected.
    -->
    <Panel Grid.Row="0" Grid.RowSpan="2"
           IsHitTestVisible="False"
           IsVisible="{Binding IsPrivateMode}"
           ZIndex="500">
      <Border BorderBrush="{DynamicResource AppPrivateGlow}"
              BorderThickness="3"
              CornerRadius="0" />
    </Panel>

  </Grid>
</UserControl>
