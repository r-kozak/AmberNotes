<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AmberNotes.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="720"
             x:Class="AmberNotes.Views.AppView"
             x:DataType="vm:AppViewModel">

    <!--
        Mobile/Single-view root — mirrors what MainWindow does on Desktop.
        AppViewModel.CurrentViewModel is mapped to its View via ViewLocator.
    -->
    <ContentControl Content="{Binding CurrentViewModel}" />

</UserControl>
