<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AmberNotes.ViewModels"
             xmlns:views="using:AmberNotes.Views"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="580"
             x:Class="AmberNotes.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource AppBackground}">

  <!--
    ═══════════════════════════════════════════════════════════════════════
    SettingsView — Settings Page (v0.6)

    Shown as CurrentPage inside MainView's TransitioningContentControl.
    Layout:
      Layer 0 (normal): ScrollViewer → settings content
      Layer 1 (overlay): Conflict resolution dialog (when ConflictViewModel ≠ null)
    ═══════════════════════════════════════════════════════════════════════
  -->

  <Grid>

    <!-- ══ Layer 0: Normal settings content ════════════════════════════ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel HorizontalAlignment="Stretch"
                  Margin="16,0,16,32"
                  Spacing="0">

        <!-- ═══════════ HEADER ═════════════════════════════════════════ -->
        <StackPanel Orientation="Horizontal"
                    Spacing="16"
                    Margin="0,28,0,28">

          <Button Content="← Назад"
                  Command="{Binding GoBackCommand}"
                  Padding="14,8"
                  CornerRadius="8">
            <Button.Styles>
              <Style Selector="Button">
                <Setter Property="Background"    Value="Transparent" />
                <Setter Property="Foreground"    Value="{DynamicResource AppSubtext}" />
                <Setter Property="BorderBrush"   Value="{DynamicResource AppBorder}" />
                <Setter Property="BorderThickness" Value="1" />
              </Style>
              <Style Selector="Button:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource AppSurface}" />
              </Style>
            </Button.Styles>
          </Button>

          <TextBlock Text="Налаштування"
                     FontSize="22"
                     FontWeight="Bold"
                     Foreground="{DynamicResource AppOnBackground}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- ═══════════ GOOGLE DRIVE CARD ══════════════════════════════ -->
        <Border Background="{DynamicResource AppSurface}"
                CornerRadius="12"
                Padding="24"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1">
          <StackPanel Spacing="20">

            <!-- Section title -->
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0"
                         Text="☁"
                         FontSize="24"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0" />
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="Google Drive"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppOnSurface}" />
                <TextBlock Text="Приховане резервне копіювання через AppData папку"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppSubtext}" />
              </StackPanel>
            </Grid>

            <!-- Divider -->
            <Border Height="1"
                    Background="{DynamicResource AppDivider}" />

            <!-- Status chip -->
            <Border CornerRadius="8"
                    Padding="14,10"
                    Background="{DynamicResource AppSurfaceVariant}">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding StatusIcon}"
                             FontSize="15"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding StatusText}"
                             FontSize="14"
                             FontWeight="Medium"
                             Foreground="{DynamicResource AppOnSurface}"
                             VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding GoogleEmail}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppSubtext}"
                           IsVisible="{Binding IsGoogleConnected}"
                           Margin="0,2,0,0" />
              </StackPanel>
            </Border>

            <!-- Progress bar (visible during async operations, but not during sync) -->
            <ProgressBar IsIndeterminate="True"
                         Height="3"
                         Foreground="{DynamicResource AppPrimary}"
                         Background="Transparent">
              <ProgressBar.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="IsBusy" />
                  <Binding Path="IsSyncing" Converter="{x:Static BoolConverters.Not}" />
                </MultiBinding>
              </ProgressBar.IsVisible>
            </ProgressBar>

            <!-- Status message -->
            <Border CornerRadius="8"
                    Padding="14,10"
                    Background="{DynamicResource AppSurfaceVariant}"
                    IsVisible="{Binding HasStatusMessage}">
              <TextBlock Text="{Binding StatusMessage}"
                         TextWrapping="Wrap"
                         FontSize="13"
                         Foreground="{DynamicResource AppSubtext}" />
            </Border>

            <!-- Action buttons -->
            <Grid ColumnDefinitions="*,12,*">

              <Button Grid.Column="0"
                      Content="{Binding ConnectButtonText}"
                      Command="{Binding ToggleGoogleDriveCommand}"
                      IsEnabled="{Binding IsNotBusy}"
                      Padding="12,11"
                      CornerRadius="8"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center">
                <Button.Styles>
                  <Style Selector="Button">
                    <Setter Property="Background"    Value="{DynamicResource AppPrimary}" />
                    <Setter Property="Foreground"    Value="{DynamicResource AppOnPrimary}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontWeight"    Value="SemiBold" />
                  </Style>
                  <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Opacity" Value="0.85" />
                  </Style>
                  <Style Selector="Button:pressed /template/ ContentPresenter">
                    <Setter Property="Opacity" Value="0.70" />
                  </Style>
                  <Style Selector="Button:disabled /template/ ContentPresenter">
                    <Setter Property="Opacity" Value="0.45" />
                  </Style>
                </Button.Styles>
              </Button>

              <Button Grid.Column="2"
                      Content="Перевірити з'єднання"
                      Command="{Binding TestConnectionCommand}"
                      IsVisible="{Binding IsGoogleConnected}"
                      IsEnabled="{Binding IsNotBusy}"
                      Padding="12,11"
                      CornerRadius="8"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center">
                <Button.Styles>
                  <Style Selector="Button">
                    <Setter Property="Background"    Value="Transparent" />
                    <Setter Property="Foreground"    Value="{DynamicResource AppPrimary}" />
                    <Setter Property="BorderBrush"   Value="{DynamicResource AppPrimary}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontWeight"    Value="Medium" />
                  </Style>
                  <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource AppSurfaceVariant}" />
                  </Style>
                  <Style Selector="Button:disabled /template/ ContentPresenter">
                    <Setter Property="Opacity" Value="0.45" />
                  </Style>
                </Button.Styles>
              </Button>

            </Grid>

            <!-- Privacy note -->
            <TextBlock TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource AppSubtext}"
                       Text="🔒 Застосунок отримує доступ виключно до своєї прихованої папки (AppData). Ваші файли у Google Drive залишаються повністю недоступними." />

          </StackPanel>
        </Border>

        <!-- ═══════════ SYNC CARD ══════════════════════════════════════ -->
        <Border Background="{DynamicResource AppSurface}"
                CornerRadius="12"
                Padding="24"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                Margin="0,16,0,0"
                IsVisible="{Binding IsGoogleConnected}">
          <StackPanel Spacing="16">

            <!-- Title -->
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0"
                         Text="🔄"
                         FontSize="22"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0" />
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="Синхронізація"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppOnSurface}" />
                <TextBlock Text="Зашифроване двостороннє резервне копіювання нотаток у хмарі"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppSubtext}" />
              </StackPanel>
            </Grid>

            <!-- Divider -->
            <Border Height="1" Background="{DynamicResource AppDivider}" />

            <!-- Password field: shown only when private vault is locked -->
            <StackPanel Spacing="6" IsVisible="{Binding ShowSyncPasswordField}">
              <TextBlock Text="Для синхронізації потрібен пароль від Приватного сховища:"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource AppSubtext}" />
              <TextBox Text="{Binding SyncPassword}"
                       PasswordChar="●"
                       PlaceholderText="Майстер-пароль від приватного сховища"
                       FontSize="14"
                       Padding="10,8"
                       CornerRadius="8"
                       Background="{DynamicResource AppBackground}"
                       BorderBrush="{DynamicResource AppBorder}"
                       BorderThickness="1" />

              <!-- Sync error message (specific to password) -->
              <Border CornerRadius="8"
                      Padding="12,8"
                      Background="#22FF5555"
                      BorderBrush="#44FF5555"
                      BorderThickness="1"
                      IsVisible="{Binding HasSyncErrorMessage}">
                <TextBlock Text="{Binding SyncErrorMessage}"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#FFFF6666"
                           FontWeight="Medium" />
              </Border>
            </StackPanel>

            <!-- Sync progress bar -->
            <ProgressBar IsIndeterminate="True"
                         Height="3"
                         IsVisible="{Binding IsSyncing}"
                         Foreground="{DynamicResource AppPrimary}"
                         Background="Transparent" />

            <!-- Sync status message (success/info) -->
            <Border CornerRadius="8"
                    Padding="14,10"
                    Background="{DynamicResource AppSurfaceVariant}"
                    IsVisible="{Binding HasSyncStatusMessage}">
              <TextBlock Text="{Binding SyncStatusMessage}"
                         TextWrapping="Wrap"
                         FontSize="13"
                         Foreground="{DynamicResource AppSubtext}" />
            </Border>

            <!-- Sync Now + Cloud Explorer buttons row -->
            <Grid ColumnDefinitions="*,12,*">

              <Button Grid.Column="0"
                      Content="🔄 Синхронізувати зараз"
                      Command="{Binding SyncNowCommand}"
                      IsEnabled="{Binding IsNotBusy}"
                      Padding="12,11"
                      CornerRadius="8"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center">
                <Button.Styles>
                  <Style Selector="Button">
                    <Setter Property="Background"    Value="{DynamicResource AppPrimary}" />
                    <Setter Property="Foreground"    Value="{DynamicResource AppOnPrimary}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FontWeight"    Value="SemiBold" />
                  </Style>
                  <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Opacity" Value="0.85" />
                  </Style>
                  <Style Selector="Button:disabled /template/ ContentPresenter">
                    <Setter Property="Opacity" Value="0.45" />
                  </Style>
                </Button.Styles>
              </Button>

              <!-- Cloud Explorer button: visible only when Google is connected -->
              <Button Grid.Column="2"
                      Command="{Binding OpenCloudExplorerCommand}"
                      IsEnabled="{Binding IsNotBusy}"
                      IsVisible="{Binding IsGoogleConnected}"
                      Padding="12,11"
                      CornerRadius="8"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center">
                <ToolTip.Tip>Amber Cloud Explorer — аудит файлів у Google Drive AppData</ToolTip.Tip>
                <Button.Content>
                  <TextBlock Text="☁ Переглянути хмару"
                             TextWrapping="Wrap"
                             TextAlignment="Center" />
                </Button.Content>
                <Button.Styles>
                  <Style Selector="Button">
                    <Setter Property="Background"    Value="Transparent" />
                    <Setter Property="Foreground"    Value="{DynamicResource AppPrimary}" />
                    <Setter Property="BorderBrush"   Value="{DynamicResource AppPrimary}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="FontWeight"    Value="Medium" />
                  </Style>
                  <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="{DynamicResource AppSurfaceVariant}" />
                  </Style>
                  <Style Selector="Button:disabled /template/ ContentPresenter">
                    <Setter Property="Opacity" Value="0.45" />
                  </Style>
                </Button.Styles>
              </Button>

            </Grid>

            <!-- Privacy note -->
            <TextBlock TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource AppSubtext}"
                       Text="🛡 Усі нотатки (публічні та приватні) шифруються AES-256-GCM перед вивантаженням. Хмара ніколи не зберігає відкритий текст." />

          </StackPanel>
        </Border>

        <!-- ═══════════ SECURITY CARD ═════════════════════════════════ -->
        <Border Background="{DynamicResource AppSurface}"
                CornerRadius="12"
                Padding="24"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                Margin="0,16,0,0">
          <StackPanel Spacing="16">

            <!-- Title -->
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0"
                         Text="🔑"
                         FontSize="22"
                         VerticalAlignment="Center"
                         Margin="0,0,12,0" />
              <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="Безпека"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppOnSurface}" />
                <TextBlock Text="Управління майстер-паролем Приватного сховища"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppSubtext}" />
              </StackPanel>
            </Grid>

            <!-- Divider -->
            <Border Height="1" Background="{DynamicResource AppDivider}" />

            <!-- Description -->
            <TextBlock TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource AppSubtext}"
                       Text="Зміна пароля включає автоматичну синхронізацію зі старим ключем (якщо є інтернет) та перешифровку бази даних новим паролем." />

            <!-- Change Password button -->
            <Button Content="🔑 Змінити пароль"
                    Command="{Binding OpenChangePasswordCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Padding="18,10"
                    CornerRadius="8"
                    HorizontalAlignment="Left">
              <Button.Styles>
                <Style Selector="Button">
                  <Setter Property="Background"    Value="{DynamicResource AppSecondary}" />
                  <Setter Property="Foreground"    Value="{DynamicResource AppOnPrimary}" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="FontWeight"    Value="SemiBold" />
                </Style>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                  <Setter Property="Opacity" Value="0.85" />
                </Style>
                <Style Selector="Button:disabled /template/ ContentPresenter">
                  <Setter Property="Opacity" Value="0.45" />
                </Style>
              </Button.Styles>
            </Button>

          </StackPanel>
        </Border>

        <!-- ═══════════ SETUP INSTRUCTIONS CARD ════════════════════════ -->
        <Border Background="{DynamicResource AppSurfaceVariant}"
                CornerRadius="10"
                Padding="22"
                BorderBrush="{DynamicResource AppDivider}"
                BorderThickness="1"
                Margin="0,16,0,0"
                IsVisible="{Binding ShowSetupHint}">
          <StackPanel Spacing="14">

            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0"
                         Text="📋"
                         FontSize="16"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <TextBlock Grid.Column="1"
                         Text="Як налаштувати Google Cloud Console"
                         FontSize="14"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource AppOnBackground}"
                         VerticalAlignment="Center" />
            </Grid>

            <StackPanel Spacing="8">
              <TextBlock TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource AppSubtext}"
                         Text="1. Відкрийте console.cloud.google.com та виберіть ваш проєкт." />
              <TextBlock TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource AppSubtext}"
                         Text="2. APIs / Services → Enable APIs → увімкніть Google Drive API." />
              <TextBlock TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource AppSubtext}"
                         Text="3. Credentials → Create Credentials → OAuth client ID → Desktop app → скопіюйте Client ID та Secret." />
              <TextBlock TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource AppSubtext}"
                         Text="4. Для Android: ще один Client ID → Android → Package: com.kozak.AmberNotes → вкажіть SHA-1." />
              <TextBlock TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource AppSubtext}"
                         Text="5. Скопіюйте oauth.config.example.json → oauth.config.json та заповніть DesktopClientId і DesktopClientSecret." />
              <TextBlock TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource AppSubtext}"
                         Text="6. Для Android: у Desktop клієнті додайте Authorized redirect URI: com.kozak.ambernotes://oauth2callback" />
            </StackPanel>

          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- ══ Layer 1: Overlay (conflict OR change password) ══════════════ -->
    <!--
      Semi-transparent backdrop + centered overlay card.
      Visible when any overlay ViewModel is active.
    -->
    <Grid IsVisible="{Binding IsOverlayVisible}"
          Background="#CC000000"
          ZIndex="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Padding="12">
        <ContentControl Content="{Binding CurrentOverlay}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="{x:Type vm:SaltConflictViewModel}">
              <views:SaltConflictView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ChangePasswordViewModel}">
              <views:ChangePasswordView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CloudExplorerViewModel}">
              <views:CloudExplorerView />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </ScrollViewer>
    </Grid>

  </Grid>

</UserControl>
