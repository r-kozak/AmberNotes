<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AmberNotes.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="AmberNotes.Views.MainWindow"
        x:DataType="vm:AppViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AmberNotes"
        MinWidth="480" MinHeight="320">

    <!--
        AppViewModel.CurrentViewModel drives all navigation:
          LoginViewModel  → LoginView   (App Lock screen, step 13)
          MainViewModel   → MainView    (Notes dashboard)
        ViewLocator (Application.DataTemplates) resolves the mapping automatically.
    -->
    <ContentControl Content="{Binding CurrentViewModel}" />

</Window>
