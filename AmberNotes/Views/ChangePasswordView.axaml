<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AmberNotes.ViewModels"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="480"
             x:Class="AmberNotes.Views.ChangePasswordView"
             x:DataType="vm:ChangePasswordViewModel">

  <!--
    ═══════════════════════════════════════════════════════════════════════
    ChangePasswordView — Change Master Password overlay (v0.6)

    Shown inside SettingsView as a ContentControl overlay (same layer
    as SaltConflictView, one at a time).

    States:
      ShowPasswordFields=true  → password entry form
      ShowOfflineWarning=true  → inline offline confirmation
      IsVaultLocked=true       → vault locked message
    ═══════════════════════════════════════════════════════════════════════
  -->

  <Border Background="{DynamicResource AppBackground}"
          CornerRadius="16"
          Padding="28"
          BorderBrush="{DynamicResource AppBorder}"
          BorderThickness="1"
          MaxWidth="540">

    <StackPanel Spacing="18">

      <!-- ══ Header ══════════════════════════════════════════════════════ -->
      <StackPanel Spacing="5">
        <TextBlock Text="🔑 Змінити майстер-пароль"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{DynamicResource AppOnBackground}" />
        <TextBlock TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{DynamicResource AppSubtext}"
                   Text="Пароль використовується для шифрування вашого Приватного сховища та синхронізації з хмарою." />
      </StackPanel>

      <!-- ── Progress bar ─────────────────────────────────────────────── -->
      <ProgressBar IsIndeterminate="True"
                   Height="3"
                   IsVisible="{Binding IsBusy}"
                   Foreground="{DynamicResource AppPrimary}"
                   Background="Transparent" />

      <!-- ── Status message ───────────────────────────────────────────── -->
      <Border CornerRadius="8"
              Padding="14,10"
              Background="{DynamicResource AppSurfaceVariant}"
              IsVisible="{Binding HasStatusMessage}">
        <TextBlock Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{DynamicResource AppSubtext}" />
      </Border>

      <!-- ══ Vault locked warning ════════════════════════════════════════ -->
      <Border CornerRadius="10"
              Padding="16"
              Background="#1AFFBF00"
              BorderBrush="#66FFBF00"
              BorderThickness="1"
              IsVisible="{Binding IsVaultLocked}">
        <TextBlock TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{DynamicResource AppOnBackground}"
                   Text="⚠ Щоб змінити пароль, спочатку відкрийте Приватне сховище — перейдіть у режим 🔒 Приватний та введіть поточний пароль." />
      </Border>

      <!-- ══ Password entry form ═════════════════════════════════════════ -->
      <StackPanel Spacing="12" IsVisible="{Binding ShowPasswordFields}">

        <!-- Current password -->
        <StackPanel Spacing="5">
          <TextBlock Text="Поточний пароль"
                     FontSize="12"
                     Foreground="{DynamicResource AppSubtext}" />
          <TextBox Text="{Binding CurrentPassword}"
                   PasswordChar="●"
                   PlaceholderText="Ваш поточний майстер-пароль"
                   FontSize="14"
                   Padding="10,9"
                   CornerRadius="8"
                   Background="{DynamicResource AppBackground}"
                   BorderBrush="{DynamicResource AppBorder}"
                   BorderThickness="1" />
        </StackPanel>

        <!-- Divider -->
        <Border Height="1" Background="{DynamicResource AppDivider}" />

        <!-- New password -->
        <StackPanel Spacing="5">
          <TextBlock Text="Новий пароль"
                     FontSize="12"
                     Foreground="{DynamicResource AppSubtext}" />
          <TextBox Text="{Binding NewPassword}"
                   PasswordChar="●"
                   PlaceholderText="Новий майстер-пароль"
                   FontSize="14"
                   Padding="10,9"
                   CornerRadius="8"
                   Background="{DynamicResource AppBackground}"
                   BorderBrush="{DynamicResource AppBorder}"
                   BorderThickness="1" />
        </StackPanel>

        <!-- Confirm new password -->
        <StackPanel Spacing="5">
          <TextBlock Text="Підтвердіть новий пароль"
                     FontSize="12"
                     Foreground="{DynamicResource AppSubtext}" />
          <TextBox Text="{Binding ConfirmNewPassword}"
                   PasswordChar="●"
                   PlaceholderText="Повторіть новий пароль"
                   FontSize="14"
                   Padding="10,9"
                   CornerRadius="8"
                   Background="{DynamicResource AppBackground}"
                   BorderBrush="{DynamicResource AppBorder}"
                   BorderThickness="1" />
        </StackPanel>

      </StackPanel>

      <!-- ══ Offline warning panel ═══════════════════════════════════════ -->
      <Border CornerRadius="10"
              Padding="18"
              Background="#1AFF8C00"
              BorderBrush="#66FF8C00"
              BorderThickness="1"
              IsVisible="{Binding ShowOfflineWarning}">
        <StackPanel Spacing="14">
          <TextBlock Text="⚠ Немає підключення до інтернету"
                     FontSize="14" FontWeight="SemiBold"
                     Foreground="#FFA500" />
          <TextBlock TextWrapping="Wrap"
                     FontSize="13"
                     Foreground="{DynamicResource AppSubtext}"
                     Text="Ми можемо змінити пароль локально, але коли з'явиться зв'язок, хмара буде повністю перезаписана вашими поточними нотатками під новим паролем. Продовжити?" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <!-- Confirm offline -->
            <Button Content="Продовжити офлайн"
                    Command="{Binding ConfirmOfflineCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Padding="14,8"
                    CornerRadius="8">
              <Button.Styles>
                <Style Selector="Button">
                  <Setter Property="Background"    Value="#FF8C00" />
                  <Setter Property="Foreground"    Value="White" />
                  <Setter Property="BorderThickness" Value="0" />
                  <Setter Property="FontWeight"    Value="SemiBold" />
                </Style>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                  <Setter Property="Opacity" Value="0.85" />
                </Style>
              </Button.Styles>
            </Button>
            <!-- Cancel offline -->
            <Button Content="Скасувати"
                    Command="{Binding CancelOfflineCommand}"
                    IsEnabled="{Binding IsNotBusy}"
                    Padding="14,8"
                    CornerRadius="8">
              <Button.Styles>
                <Style Selector="Button">
                  <Setter Property="Background"      Value="Transparent" />
                  <Setter Property="Foreground"      Value="{DynamicResource AppSubtext}" />
                  <Setter Property="BorderBrush"     Value="{DynamicResource AppBorder}" />
                  <Setter Property="BorderThickness" Value="1" />
                </Style>
              </Button.Styles>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ══ Action buttons (main) ══════════════════════════════════════ -->
      <StackPanel Orientation="Horizontal"
                  Spacing="12"
                  HorizontalAlignment="Right"
                  IsVisible="{Binding ShowPasswordFields}">

        <!-- Cancel -->
        <Button Content="Скасувати"
                Command="{Binding CancelCommand}"
                IsEnabled="{Binding IsNotBusy}"
                Padding="16,9"
                CornerRadius="8">
          <Button.Styles>
            <Style Selector="Button">
              <Setter Property="Background"      Value="Transparent" />
              <Setter Property="Foreground"      Value="{DynamicResource AppSubtext}" />
              <Setter Property="BorderBrush"     Value="{DynamicResource AppBorder}" />
              <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style Selector="Button:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource AppSurface}" />
            </Style>
          </Button.Styles>
        </Button>

        <!-- Change password (primary) -->
        <Button Content="🔑 Змінити пароль"
                Command="{Binding ChangePasswordCommand}"
                Padding="18,9"
                CornerRadius="8">
          <Button.Styles>
            <Style Selector="Button">
              <Setter Property="Background"      Value="{DynamicResource AppPrimary}" />
              <Setter Property="Foreground"      Value="{DynamicResource AppOnPrimary}" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="FontWeight"      Value="SemiBold" />
            </Style>
            <Style Selector="Button:pointerover /template/ ContentPresenter">
              <Setter Property="Opacity" Value="0.85" />
            </Style>
            <Style Selector="Button:disabled /template/ ContentPresenter">
              <Setter Property="Opacity" Value="0.45" />
            </Style>
          </Button.Styles>
        </Button>

      </StackPanel>

      <!-- Close button shown when vault is locked -->
      <Button Content="Закрити"
              Command="{Binding CancelCommand}"
              HorizontalAlignment="Right"
              Padding="16,9"
              CornerRadius="8"
              IsVisible="{Binding IsVaultLocked}">
        <Button.Styles>
          <Style Selector="Button">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="Foreground"      Value="{DynamicResource AppSubtext}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource AppBorder}" />
            <Setter Property="BorderThickness" Value="1" />
          </Style>
        </Button.Styles>
      </Button>

    </StackPanel>
  </Border>

</UserControl>
